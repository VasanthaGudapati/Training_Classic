# Database URL
# Render PostgreSQL format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# For local dev fallback to SQLite: sqlite:///local.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cs_revision

# Secret key used for signing JWT tokens (Use a strong random string in production)
JWT_SECRET=change_this_to_a_secure_random_secret_key_for_production

# Allowed origins for CORS (comma-separated URLs, or * for open access)
# Example: https://your-app.netlify.app,http://localhost:5173
ALLOWED_ORIGINS=*
